# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional. Not used by the server today; keep it out of git if you add client reads later.
# SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Razorpay Dashboard → Account & Settings → API Keys
# Use rzp_test_… while developing. Switch to rzp_live_… only for production.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# Optional. Dashboard → Webhooks. Enables /api/razorpay-webhook as a backup to Checkout.
# RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Shown on the Razorpay Checkout modal
GRADFLOW_CHECKOUT_NAME=Gradflow

# Local server only
PORT=4173
