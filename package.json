{
  "name": "sandipchikane-profile",
  "version": "1.0.0",
  "description": "GitHub profile README with linting and a GitHub-styled live preview.",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "preview": "node scripts/preview-server.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "github-markdown-css": "^5.6.1",
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.13.0"
  },
  "engines": {
    "node": ">=20"
  }
}
